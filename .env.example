# Salin file ini menjadi .env lalu isi token dari @BotFather.
# JANGAN bagikan atau unggah file .env ke mana pun.
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Kunci acak untuk menandatangani link dashboard web.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=ganti_dengan_kunci_acak_panjang

# Alamat server web lokal.
WEB_ENABLED=1
WEB_HOST=0.0.0.0
WEB_PORT=8000

# Opsional: isi bila deteksi IP LAN otomatis memilih antarmuka yang salah.
# WEB_BASE_URL=http://192.168.1.10:8000
